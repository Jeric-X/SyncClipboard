<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>xyz.jericx.desktop.syncclipboard</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>SyncClipboard</name>
  <summary>Sync your clipboard across devices and manage clipboard history</summary>
  <summary xml:lang="zh-CN">跨设备同步剪贴板并管理剪贴板历史记录</summary>
  <description>
    <p>
      SyncClipboard synchronizes clipboard content across Windows, macOS, Linux
      and compatible mobile clients. Share text, images and files between your
      devices, and browse or search your clipboard history.
    </p>
    <p>
      Connect to a SyncClipboard server, use the server built into the desktop
      client, or sync through WebDAV and S3-compatible storage.
    </p>
    <p xml:lang="zh-CN">
      SyncClipboard 可在 Windows、macOS、Linux 和兼容的移动端客户端之间同步剪贴板。
      在设备间共享文本、图片和文件，并浏览或搜索剪贴板历史记录。
    </p>
    <p xml:lang="zh-CN">
      支持连接 SyncClipboard 服务器、使用桌面客户端内置服务器，
      或通过 WebDAV 和 S3 兼容存储同步。
    </p>
  </description>
  <developer id="xyz.jericx">

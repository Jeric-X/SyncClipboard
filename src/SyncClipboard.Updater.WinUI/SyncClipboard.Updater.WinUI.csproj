<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../SyncClipboard.Updater.Core/Updater.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64;AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CETCompat>false</CETCompat>
    <!-- .NET 10 NativeAOT reference tracking can deadlock during GC without optimizations,
         including when the main application is built in Debug: dotnet/runtime#121538. -->
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefineConstants Condition="'$(WindowsAppSDKSelfContained)' == 'true'">$(DefineConstants);UPDATER_LOCAL_RUNTIME</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UpdaterUseAvalonia Condition="'$(RuntimeIdentifier)' != ''">$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))</UpdaterUseAvalonia>
    <UpdaterUseAvalonia Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('Linux'))</UpdaterUseAvalonia>
    <DefineConstants Condition="'$(UpdaterUseAvalonia)' == 'true'">$(DefineConstants);UPDATER_AVALONIA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UpdaterUseAvalonia)' == 'true'">
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup Condition="'$(UpdaterUseAvalonia)' != 'true'">
    <Compile Remove="UpdaterApplication.cs;UpdateWindow.cs" />
  </ItemGroup>
</Project>

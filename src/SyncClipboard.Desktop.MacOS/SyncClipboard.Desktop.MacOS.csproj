<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationId>xyz.jericx.desktop.syncclipboard</ApplicationId>
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <ApplicationVersion>$(VersionPrefix)</ApplicationVersion>
    <SelfContained>true</SelfContained>
    <SupportedOSPlatformVersion>12.7</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64;AnyCPU</Platforms>
    <CreatePackage>false</CreatePackage>
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <CodesignEntitlements>..\..\build\macos\SyncClipboard.entitlements</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncClipboard.Desktop\SyncClipboard.Desktop.csproj" />
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <ItemGroup>
      <LicenseFiles Include="$(ProjectDir)\..\..\LICENSES\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(LicenseFiles)"
      DestinationFolder="$(OutDir)\SyncClipboard.Desktop.MacOS.app\Contents\MonoBundle\LICENSES\%(RecursiveDir)"
      SkipUnchangedFiles="true"
      OverwriteReadOnlyFiles="true"
      Retries="3"
      RetryDelayMilliseconds="300"/>
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="..\..\build\macos\icon.icns" Link="icon.icns" />
    <PartialAppManifest Include="..\..\build\macos\Info.plist" />
  </ItemGroup>

</Project>

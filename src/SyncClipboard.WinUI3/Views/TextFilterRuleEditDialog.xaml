<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="SyncClipboard.WinUI3.Views.TextFilterRuleEditDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:SyncClipboard.WinUI3.Views"
               xmlns:i18n="using:SyncClipboard.Core.I18n"
               xmlns:vc="using:SyncClipboard.WinUI3.ValueConverters"
               xmlns:vm="using:SyncClipboard.Core.ViewModels"
               PrimaryButtonText="{x:Bind i18n:Strings.Confirm}"
               CloseButtonText="{x:Bind i18n:Strings.Cancel}"
               IsPrimaryButtonEnabled="{x:Bind Editor.IsValid, Mode=OneWay}"
               DefaultButton="Primary">
    <ContentDialog.Resources>
        <Style TargetType="local:TextFilterRuleEditDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
    </ContentDialog.Resources>
    <StackPanel Spacing="12">
        <ComboBox Header="{x:Bind i18n:Strings.MatchMode}"
                  ItemsSource="{x:Bind vm:EditableTextFilterRule.MatchModes}"
                  SelectedItem="{x:Bind Editor.MatchMode, Mode=TwoWay}"
                  DisplayMemberPath="ShownString" />
        <TextBox Header="{x:Bind i18n:Strings.FileFilterPattern}" PlaceholderText="{x:Bind i18n:Strings.TextFilterPattern}" Text="{x:Bind Editor.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Visibility="{x:Bind vc:ConvertMethod.ObjectToVisibility(Editor.ValidationError), Mode=OneWay}"
                   Text="{x:Bind Editor.ValidationError, Mode=OneWay}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" />
        <CheckBox Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(Editor.CanExcludeFromHistory)}" Content="{x:Bind i18n:Strings.ExcludeFromLocalHistory}" IsChecked="{x:Bind Editor.ExcludeFromHistory, Mode=TwoWay}" />
    </StackPanel>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="SyncClipboard.WinUI3.Views.FileFilterRuleEditDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:SyncClipboard.WinUI3.Views"
               xmlns:i18n="using:SyncClipboard.Core.I18n"
               xmlns:vm="using:SyncClipboard.Core.ViewModels"
               Title="{x:Bind i18n:Strings.EditRule}"
               PrimaryButtonText="{x:Bind i18n:Strings.Confirm}"
               CloseButtonText="{x:Bind i18n:Strings.Cancel}"
               DefaultButton="Primary">
    <ContentDialog.Resources>
        <Style TargetType="local:FileFilterRuleEditDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
    </ContentDialog.Resources>
    <StackPanel MinWidth="420" MaxWidth="620" Spacing="12">
        <ComboBox Header="{x:Bind i18n:Strings.MatchMode}"
                  ItemsSource="{x:Bind vm:FileSyncFilterSettingViewModel.MatchModes}"
                  SelectedItem="{x:Bind Editor.MatchMode, Mode=TwoWay}"
                  DisplayMemberPath="ShownString" />
        <TextBox Header="{x:Bind i18n:Strings.FileFilterPattern}" PlaceholderText="{x:Bind i18n:Strings.FileFilterPattern}" Text="{x:Bind Editor.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <HyperlinkButton HorizontalAlignment="Left"
                         Padding="0"
                         Content="{x:Bind i18n:Strings.RegularExpressionQuickReference}"
                         Click="RegularExpressionQuickReference_Click" />
        <TextBlock x:Name="_ValidationMessage" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>

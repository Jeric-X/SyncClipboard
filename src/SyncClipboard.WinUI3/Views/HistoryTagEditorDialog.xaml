<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="SyncClipboard.WinUI3.Views.HistoryTagEditorDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:SyncClipboard.WinUI3.Views"
               xmlns:controls="using:SyncClipboard.WinUI3.Controls"
               xmlns:vc="using:SyncClipboard.WinUI3.ValueConverters"
               xmlns:vm="using:SyncClipboard.Core.ViewModels"
               xmlns:i18n="using:SyncClipboard.Core.I18n"
               Title="{Binding Title}"
               PrimaryButtonText="{x:Bind i18n:Strings.HistoryTagsApply}"
               CloseButtonText="{x:Bind i18n:Strings.Cancel}"
               DefaultButton="Primary"
               PrimaryButtonClick="OnPrimaryButtonClick">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">380</x:Double>
        <vc:StringToVisibilityConverter x:Key="StringToVisibility" />
        <Style TargetType="local:HistoryTagEditorDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
    </ContentDialog.Resources>
    <StackPanel Spacing="10">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind i18n:Strings.HistoryTagsSearch}" />
            <Button Grid.Column="1" Content="{x:Bind i18n:Strings.HistoryTagsAdd}" Command="{Binding AddCommand}" />
        </Grid>
        <ScrollViewer Height="200">
            <ItemsControl ItemsSource="{Binding FilteredChoices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryTagChoice">
                        <controls:HistoryTagCheckBox Content="{x:Bind Name}" IsThreeState="True" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />
    </StackPanel>
</ContentDialog>

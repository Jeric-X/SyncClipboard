<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="SyncClipboard.WinUI3.Views.CurrentNetworkStatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:i18n="using:SyncClipboard.Core.I18n"
      xmlns:vm="using:SyncClipboard.Core.ViewModels"
      xmlns:vc="using:SyncClipboard.WinUI3.ValueConverters">
    <StackPanel Spacing="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{x:Bind i18n:Strings.CurrentNetworkStatus}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind _viewModel.SummaryText, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{x:Bind i18n:Strings.RecheckNetwork}"
                    Command="{x:Bind _viewModel.RefreshCommand}" />
        </Grid>

        <TextBlock Padding="12"
                   HorizontalAlignment="Stretch"
                   Text="{x:Bind i18n:Strings.NoNetworkConnections}"
                   TextAlignment="Center"
                   Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(_viewModel.ShowEmptyState), Mode=OneWay}" />

        <ItemsControl ItemsSource="{x:Bind _viewModel.Connections, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NetworkConnectionStatusItem">
                    <Border Margin="0,0,0,10"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{x:Bind DisplayName}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <Border Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                    <TextBlock FontSize="12" Text="{x:Bind GatewayStatusText}" />
                                </Border>
                            </Grid>

                            <Grid Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(HasWifi)}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind i18n:Strings.WifiName}" />
                                <TextBlock Grid.Column="1"
                                           Margin="12,0,0,0"
                                           Text="{x:Bind WifiSsid}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <StackPanel Spacing="5" Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(HasIpv4)}">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind i18n:Strings.Ipv4Addresses}" />
                                <ItemsControl ItemsSource="{x:Bind Ipv4Addresses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NetworkAddressStatusItem">
                                            <Border Margin="0,2,0,0"
                                                    Padding="10,6"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="4">
                                                <TextBlock FontFamily="Consolas" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="5" Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(HasIpv6)}">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind i18n:Strings.Ipv6Addresses}" />
                                <ItemsControl ItemsSource="{x:Bind Ipv6Addresses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NetworkAddressStatusItem">
                                            <Border Margin="0,2,0,0"
                                                    Padding="10,6"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="4">
                                                <TextBlock FontFamily="Consolas" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>

<ContentDialog x:Class="SyncClipboard.WinUI3.Views.HistoryExportDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:converters="using:CommunityToolkit.WinUI.Converters"
               xmlns:local="using:SyncClipboard.WinUI3.Views"
               xmlns:i18n="using:SyncClipboard.Core.I18n"
               Title="{x:Bind i18n:Strings.HistoryExport}"
               CloseButtonText="{x:Bind i18n:Strings.HistoryExportClose}">
    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="local:HistoryExportDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
    </ContentDialog.Resources>
    <ScrollViewer MaxHeight="540">
        <StackPanel MinWidth="400" MaxWidth="600" Spacing="12">
            <TextBlock Text="{Binding RangeDescription}" Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
            <TextBox Text="{Binding Directory, Mode=OneWay}"
                     Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisibility}}"
                     IsReadOnly="True"
                     TextWrapping="Wrap" />
            <Button Content="{x:Bind i18n:Strings.HistoryExportChangeDirectory}" Command="{Binding ChangeDirectoryCommand}" Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisibility}}" />
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <Button Content="{x:Bind i18n:Strings.HistoryExportStart}" Command="{Binding StartCommand}" Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Spacing="4" Visibility="{Binding HasArchive, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Bind i18n:Strings.HistoryExportArchive}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ArchivePath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
            <StackPanel Spacing="4" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Bind i18n:Strings.HistoryExportReport}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ReportPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
            <Button Content="{x:Bind i18n:Strings.OpenFolder}" Command="{Binding OpenFolderCommand}" Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="SyncClipboard.WinUI3.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SyncClipboard.WinUI3.Views"
        xmlns:controls="using:SyncClipboard.WinUI3.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vc="using:SyncClipboard.WinUI3.ValueConverters"
        xmlns:i18n="using:SyncClipboard.Core.I18n"
        xmlns:sys="using:System"
        xmlns:m="using:SyncClipboard.Core.Models"
        xmlns:vm="using:SyncClipboard.Core.ViewModels"
        xmlns:vms="using:SyncClipboard.Core.ViewModels.Sub"
        x:Name="_HistoryWindow"
        Title="HistoryWindow"
        mc:Ignorable="d">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="_HistoryWindowGrid"
          KeyDown="Grid_KeyDown"
          KeyboardAcceleratorPlacementMode="Hidden"
          RowDefinitions="Auto, Auto, *">
        <Grid.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource DateTimePickerFlyoutButtonStyle}">
                <Setter Property="Height" Value="28" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Padding" Value="0,0,0,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="FontIcon">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <DataTemplate x:Key="normalTemplate" x:DataType="vms:HistoryRecordVM">
                <TextBlock Text="{x:Bind vc:ConvertMethod.LimitHistoryListText(Text, local:HistoryListModeProxy.Current.IsCompactListMode), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
            <DataTemplate x:Key="imageTemplate" x:DataType="vms:HistoryRecordVM">
                <StackPanel Orientation="Vertical" Spacing="5">
                    <Image MaxHeight="200"
                           HorizontalAlignment="Left"
                           Stretch="None"
                           ImageOpened="Image_ImageOpened"
                           DragStarting="Item_DragStarting"
                           CanDrag="True"
                           Source="{x:Bind vc:ConvertMethod.CreateBitmap(PreviewImage), Mode=OneWay}"
                           Visibility="Collapsed" />
                    <TextBlock HorizontalAlignment="Left" Text="{x:Bind vc:ConvertMethod.LimitHistoryListText(Text, local:HistoryListModeProxy.Current.IsCompactListMode), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
            <local:ClipboardViewerTemplateSelector x:Key="clipboardTemplateSelector" Normal="{StaticResource normalTemplate}" Image="{StaticResource imageTemplate}" />
            <local:FontScaleProxy x:Key="FontScaleProxy" />
            <Flyout x:Key="FontScaleFlyout" Opening="FontScaleFlyout_Opening">
                <StackPanel Orientation="Horizontal" Padding="4" Spacing="4">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" />
                    <NumberBox Minimum="25"
                               Maximum="400"
                               SmallChange="5"
                               LargeChange="25"
                               SpinButtonPlacementMode="Inline"
                               Width="200"
                               AcceptsExpression="False"
                               ValueChanged="FontScaleNumberBox_ValueChanged" />
                    <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </Flyout>
        </Grid.Resources>
        <Grid x:Name="_TitleBar" Grid.Row="0" MinHeight="40">
            <SelectorBar x:Name="_FilterSelectorBar"
                         Margin="8,0,8,0"
                         Padding="0,-4,0,0"
                         HorizontalAlignment="Center"
                         IsTabStop="False"
                         PointerPressed="FilterSelectorBar_PointerPressed"
                         AllowFocusOnInteraction="False"
                         SelectionChanged="SelectorBar_SelectionChanged" />
            <StackPanel x:Name="_ButtonArea"
                        Margin="0,2,8,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4">
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}" ToolTipService.ToolTip="{x:Bind i18n:Strings.WindowTopmost}" IsChecked="{x:Bind _viewModel.IsTopmost, Mode=TwoWay}">
                    <FontIcon Glyph="&#xE840;" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}" ToolTipService.ToolTip="{x:Bind i18n:Strings.OnlyShowStarred}" IsChecked="{x:Bind _viewModel.OnlyShowStarred, Mode=TwoWay}">
                    <FontIcon Glyph="&#xE734;" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}" ToolTipService.ToolTip="{x:Bind i18n:Strings.PreviewPanel}" IsChecked="{x:Bind _viewModel.ShowPreviewPanel, Mode=TwoWay}">
                    <FontIcon Glyph="&#xE90C;" />
                </ToggleButton>
                <Button x:Name="_MenuButton"
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE10C;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="{x:Bind i18n:Strings.OperationInstructions}" Command="{x:Bind _viewModel.ShowOperationInstructionsCommand}" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem Text="{x:Bind i18n:Strings.ScrollToTopOnReopen}" IsChecked="{x:Bind _viewModel.ScrollToTopOnReopen, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="{x:Bind i18n:Strings.CloseHistoryWindowWhenLostFocus}" IsChecked="{x:Bind _viewModel.CloseWhenLostFocus, Mode=TwoWay}" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem Text="{x:Bind i18n:Strings.ShowSyncStatus}" IsChecked="{x:Bind _viewModel.ShowSyncState, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="{x:Bind i18n:Strings.ShowStarredFilter}" IsChecked="{x:Bind _viewModel.ShowStarredFilter, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="{x:Bind i18n:Strings.SortByLastAccessed}" IsChecked="{x:Bind _viewModel.SortByLastAccessed, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="{x:Bind i18n:Strings.CompactListWhenPreview}" IsChecked="{x:Bind _viewModel.CompactListWhenPreview, Mode=TwoWay}" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem Text="{x:Bind i18n:Strings.FollowCaretPosition}" IsChecked="{x:Bind _viewModel.FollowCaretPosition, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="{x:Bind i18n:Strings.FollowForegroundWindowScreen}" IsChecked="{x:Bind _viewModel.FollowForegroundWindowScreen, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="{x:Bind i18n:Strings.FollowMousePosition}" IsChecked="{x:Bind _viewModel.FollowMousePosition, Mode=TwoWay}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind i18n:Strings.FontScale}" Click="FontScaleMenuItem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        Command="{x:Bind _viewModel.CloseCommand}">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="20,8,8,8" ColumnDefinitions="*, Auto">
            <TextBox x:Name="_SearchTextBox"
                     Grid.Column="0"
                     VerticalContentAlignment="Center"
                     Text="{x:Bind _viewModel.SearchText, Mode=TwoWay}"
                     PlaceholderText="{x:Bind i18n:Strings.HistorySearchPlaceholder}"
                     KeyboardAcceleratorPlacementMode="Hidden"
                     TextChanged="SearchTextBox_TextChanged">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Home" Modifiers="Control" Invoked="CtrlHome_Invoked" />
                    <KeyboardAccelerator Key="End" Modifiers="Control" Invoked="CtrlEnd_Invoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Width="32"
                        Height="32"
                        Command="{x:Bind _viewModel.RefreshCommand}"
                        ToolTipService.ToolTip="{x:Bind i18n:Strings.Refresh}">
                    <Grid>
                        <FontIcon Glyph="&#xE72C;" Visibility="{x:Bind vc:ConvertMethod.BoolToVisibilityNegate(_viewModel.IsLoading), Mode=OneWay}" />
                        <ProgressRing Width="16"
                                      Height="16"
                                      IsActive="{x:Bind _viewModel.IsLoading, Mode=OneWay}"
                                      Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(_viewModel.IsLoading), Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button Width="32"
                        Height="32"
                        Command="{x:Bind _viewModel.ScrollToTopCommand}"
                        ToolTipService.ToolTip="{x:Bind i18n:Strings.ScrollToTop}">
                    <FontIcon Glyph="&#xE898;" />
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2"
              x:Name="_MainContentGrid"
              ColumnDefinitions="Auto, Auto, *"
              RowDefinitions="*, Auto">
            <Image x:Name="_InvisualableImage"
                   MaxHeight="201"
                   Stretch="None"
                   IsHitTestVisible="False"
                   Opacity="0" />
            <controls:HistoryListView x:Name="_ListView"
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      MinWidth="150"
                                      IsTabStop="False"
                                      ItemsSource="{x:Bind _viewModel.HistoryItems, Mode=OneWay}"
                                      SelectionMode="Single"
                                      IsMultiSelectCheckBoxEnabled="False"
                                      SuppressPointerSelection="{x:Bind _viewModel.IsMultiSelecting, Mode=OneWay}"
                                      ContainerContentChanging="ListView_ContainerContentChanging">
                <controls:HistoryListView.ItemTemplate>
                    <DataTemplate x:DataType="vms:HistoryRecordVM">
                        <Grid x:Name="HistoryItemContent"
                              MinHeight="10"
                              DragStarting="Item_DragStarting"
                              CanDrag="True"
                              ColumnDefinitions="Auto, Auto, *, Auto, Auto"
                              Background="Transparent"
                              Opacity="{x:Bind vc:ConvertMethod.SyncStateToOpacity(SyncState), Mode=OneWay}">
                            <CheckBox Grid.Column="0"
                                      Margin="0,0,8,0"
                                      MinWidth="0"
                                      Padding="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsTabStop="False"
                                      IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                      Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(local:HistoryListModeProxy.Current.IsMultiSelecting), Mode=OneWay}"
                                      Click="RecordSelectionCheckBox_Click" />
                            <Border Grid.Column="1" Height="40" VerticalAlignment="Top">
                                <Path Width="14"
                                      Height="14"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1"
                                      Data="{x:Bind vc:ConvertMethod.HistoryRecordToHugeiconsGeometry(Type, FilePath), Mode=OneWay}" />
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                <ContentControl Padding="8,8,0,8"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontSize="{Binding FontSize, Source={StaticResource FontScaleProxy}}"
                                                Content="{x:Bind}"
                                                ContentTemplateSelector="{StaticResource clipboardTemplateSelector}" />
                            </StackPanel>
                            <Border Grid.Column="3"
                                    Height="40"
                                    VerticalAlignment="Top"
                                    Padding="12,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind RelativeTime, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Opacity="0.6"
                                               FontSize="12"
                                               ToolTipService.ToolTip="{x:Bind FullDateTime, Mode=OneWay}" />
                                    <!--  Control buttons - hidden when preview panel is open  -->
                                    <local:RecordControlBar Record="{x:Bind}" Loaded="RecordControlBarLoaded" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4"
                                    Width="2"
                                    Margin="4,0,4,0"
                                    Background="{x:Bind vc:ConvertMethod.SyncStateToBrush(SyncState), Mode=OneWay}"
                                    Loaded="StatusBorderLoaded"
                                    ToolTipService.ToolTip="{x:Bind vc:ConvertMethod.SyncStateToText(SyncState)}" />
                        </Grid>
                    </DataTemplate>
                </controls:HistoryListView.ItemTemplate>
            </controls:HistoryListView>
            <Border x:Name="_PreviewSplitter"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(_viewModel.ShowPreviewPanel), Mode=OneWay}"
                    PointerEntered="PreviewSplitter_PointerEntered"
                    PointerExited="PreviewSplitter_PointerExited"
                    PointerPressed="PreviewSplitter_PointerPressed"
                    PointerMoved="PreviewSplitter_PointerMoved"
                    PointerReleased="PreviewSplitter_PointerReleased" />
            <controls:PreviewPanel x:Name="_PreviewPanel"
                                   Grid.Row="0"
                                   Grid.Column="2"
                                   Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(_viewModel.ShowPreviewPanel), Mode=OneWay}"
                                   ViewModel="{x:Bind _viewModel, Mode=OneWay}"
                                   SelectedItem="{x:Bind _viewModel.PreviewedHistoryItem, Mode=OneWay}" />
            <Border Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Padding="8,4"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(_viewModel.IsMultiSelecting), Mode=OneWay}">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="{x:Bind sys:String.Format(i18n:Strings.HistoryMultiSelectStatus, _viewModel.SelectedHistoryCount, _viewModel.SelectedInCurrentFilterCount), Mode=OneWay}" VerticalAlignment="Center" Margin="8,0" />
                    <CommandBar Grid.Column="1"
                                MinHeight="40"
                                DefaultLabelPosition="Right"
                                IsOpen="True"
                                IsDynamicOverflowEnabled="False"
                                OverflowButtonVisibility="Collapsed"
                                Background="Transparent">
                        <AppBarButton Label="{x:Bind i18n:Strings.HistoryMultiSelectAll}" LabelPosition="Default" Command="{x:Bind _viewModel.ToggleCurrentFilterSelectionCommand}">
                            <AppBarButton.Icon>
                                <FontIcon x:Name="_SelectAllIcon" Glyph="&#xE739;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="{x:Bind i18n:Strings.HistoryMultiSelectDelete}"
                                      LabelPosition="Default"
                                      Icon="Delete"
                                      Command="{x:Bind _viewModel.ConfirmDeleteSelectedCommand}" />
                        <AppBarButton Label="{x:Bind i18n:Strings.HistoryMultiSelectStar}" LabelPosition="Default" Command="{x:Bind _viewModel.ConfirmToggleSelectedStarredCommand}">
                            <AppBarButton.Icon>
                                <SymbolIcon x:Name="_ToggleStarIcon" Symbol="OutlineStar" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="{x:Bind i18n:Strings.HistoryMultiSelectExit}"
                                      LabelPosition="Default"
                                      Icon="Cancel"
                                      Command="{x:Bind _viewModel.ExitMultiSelectCommand}" />
                    </CommandBar>
                </Grid>
            </Border>
        </Grid>
        <InfoBar x:Name="_InfoBar"
                 Grid.Row="2"
                 Width="400"
                 Margin="0,0,0,100"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 IsOpen="{x:Bind _viewModel.ShowInfoBar, Mode=OneWay}"
                 Message="{x:Bind _viewModel.InfoBarMessage, Mode=OneWay}"
                 Severity="Warning"
                 IsClosable="True" />
    </Grid>
</Window>

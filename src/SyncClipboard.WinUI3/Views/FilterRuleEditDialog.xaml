<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="SyncClipboard.WinUI3.Views.FilterRuleEditDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:SyncClipboard.WinUI3.Views"
               xmlns:i18n="using:SyncClipboard.Core.I18n"
               xmlns:vc="using:SyncClipboard.WinUI3.ValueConverters"
               PrimaryButtonText="{x:Bind i18n:Strings.Confirm}"
               CloseButtonText="{x:Bind i18n:Strings.Cancel}"
               IsPrimaryButtonEnabled="{x:Bind Editor.IsValid, Mode=OneWay}"
               DefaultButton="Primary">
    <ContentDialog.Resources>
        <Style TargetType="local:FilterRuleEditDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
    </ContentDialog.Resources>
    <StackPanel MinWidth="420" MaxWidth="620" Spacing="12">
        <ComboBox Header="{x:Bind i18n:Strings.MatchMode}"
                  ItemsSource="{x:Bind Editor.MatchModes}"
                  SelectedItem="{x:Bind Editor.MatchMode, Mode=TwoWay}"
                  DisplayMemberPath="ShownString" />
        <TextBox Header="{x:Bind i18n:Strings.FileFilterPattern}" Text="{x:Bind Editor.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <HyperlinkButton HorizontalAlignment="Left"
                         Padding="0"
                         Content="{x:Bind i18n:Strings.RegularExpressionQuickReference}"
                         Click="RegularExpressionQuickReference_Click" />
        <CheckBox Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(Editor.CanExcludeFromHistory)}" Content="{x:Bind i18n:Strings.ExcludeFromLocalHistory}" IsChecked="{x:Bind Editor.ExcludeFromHistory, Mode=TwoWay}" />
        <TextBlock Text="{x:Bind Editor.ValidationError, Mode=OneWay}"
                   Visibility="{x:Bind vc:ConvertMethod.ObjectToVisibility(Editor.ValidationError), Mode=OneWay}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>

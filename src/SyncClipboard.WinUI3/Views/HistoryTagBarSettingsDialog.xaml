<ContentDialog x:Class="SyncClipboard.WinUI3.Views.HistoryTagBarSettingsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:SyncClipboard.WinUI3.Views"
               xmlns:vm="using:SyncClipboard.Core.ViewModels"
               xmlns:i18n="using:SyncClipboard.Core.I18n"
               xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
               xmlns:vc="using:SyncClipboard.WinUI3.ValueConverters"
               Title="{x:Bind i18n:Strings.HistoryTagBarSettings}"
               PrimaryButtonText="{x:Bind i18n:Strings.HistoryTagsApply}"
               CloseButtonText="{x:Bind i18n:Strings.Cancel}"
               PrimaryButtonClick="OnPrimaryButtonClick">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">520</x:Double>
        <Style TargetType="local:HistoryTagBarSettingsDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
        <vc:StringToVisibilityConverter x:Key="StringToVisibility" />
        <PathGeometry x:Key="PinOutlineGeometry" FillRule="EvenOdd">
            <PathFigure StartPoint="12.1523,3.7617" IsClosed="True">
                <QuadraticBezierSegment Point1="12.5156,3.0469" Point2="13.2012,2.6953" />
                <QuadraticBezierSegment Point1="13.8867,2.3438" Point2="14.6543,2.4609" />
                <QuadraticBezierSegment Point1="15.4219,2.5781" Point2="15.9844,3.1406" />
                <LineSegment Point="20.8594,8.0039" />
                <QuadraticBezierSegment Point1="21.4219,8.5664" Point2="21.5391,9.334" />
                <QuadraticBezierSegment Point1="21.6562,10.1016" Point2="21.3047,10.793" />
                <QuadraticBezierSegment Point1="20.9531,11.4844" Point2="20.2383,11.8477" />
                <LineSegment Point="16.0898,13.9336" />
                <QuadraticBezierSegment Point1="15.4688,14.2383" Point2="15.2227,14.8711" />
                <LineSegment Point="13.5,19.1719" />
                <QuadraticBezierSegment Point1="13.2656,19.7695" Point2="12.627,19.9043" />
                <QuadraticBezierSegment Point1="11.9883,20.0391" Point2="11.5312,19.582" />
                <LineSegment Point="8.4023,16.4531" />
                <LineSegment Point="4.4531,20.4023" />
                <LineSegment Point="3.5977,20.4023" />
                <LineSegment Point="3.5977,19.5469" />
                <LineSegment Point="7.5469,15.5977" />
                <LineSegment Point="4.418,12.4688" />
                <QuadraticBezierSegment Point1="3.9609,12.0117" Point2="4.0898,11.373" />
                <QuadraticBezierSegment Point1="4.2188,10.7344" Point2="4.8164,10.5" />
                <LineSegment Point="9.1289,8.7773" />
                <QuadraticBezierSegment Point1="9.7617,8.5312" Point2="10.0664,7.9102" />
                <LineSegment Point="12.1523,3.7617" />
            </PathFigure>
            <PathFigure StartPoint="15.1406,3.9844" IsClosed="True">
                <QuadraticBezierSegment Point1="14.707,3.5508" Point2="14.0977,3.6504" />
                <QuadraticBezierSegment Point1="13.4883,3.75" Point2="13.2188,4.3008" />
                <LineSegment Point="11.1445,8.4492" />
                <QuadraticBezierSegment Point1="10.6289,9.4688" Point2="9.5742,9.8906" />
                <LineSegment Point="5.2734,11.6133" />
                <LineSegment Point="12.3867,18.7266" />
                <LineSegment Point="14.1094,14.4258" />
                <QuadraticBezierSegment Point1="14.5312,13.3711" Point2="15.5508,12.8555" />
                <LineSegment Point="19.6992,10.7812" />
                <QuadraticBezierSegment Point1="20.25,10.5117" Point2="20.3496,9.9023" />
                <QuadraticBezierSegment Point1="20.4492,9.293" Point2="20.0156,8.8594" />
                <LineSegment Point="15.1406,3.9844" />
            </PathFigure>
        </PathGeometry>
        <PathGeometry x:Key="PinnedGeometry" FillRule="EvenOdd">
            <PathFigure StartPoint="12.1523,3.7617" IsClosed="True">
                <QuadraticBezierSegment Point1="12.5156,3.0469" Point2="13.2012,2.6953" />
                <QuadraticBezierSegment Point1="13.8867,2.3438" Point2="14.6543,2.4609" />
                <QuadraticBezierSegment Point1="15.4219,2.5781" Point2="15.9844,3.1406" />
                <LineSegment Point="20.8594,8.0039" />
                <QuadraticBezierSegment Point1="21.4219,8.5664" Point2="21.5391,9.334" />
                <QuadraticBezierSegment Point1="21.6562,10.1016" Point2="21.3047,10.793" />
                <QuadraticBezierSegment Point1="20.9531,11.4844" Point2="20.2383,11.8477" />
                <LineSegment Point="16.0898,13.9336" />
                <QuadraticBezierSegment Point1="15.4688,14.2383" Point2="15.2227,14.8711" />
                <LineSegment Point="13.5,19.1719" />
                <QuadraticBezierSegment Point1="13.2656,19.7695" Point2="12.627,19.9043" />
                <QuadraticBezierSegment Point1="11.9883,20.0391" Point2="11.5312,19.582" />
                <LineSegment Point="8.4023,16.4531" />
                <LineSegment Point="4.4531,20.4023" />
                <LineSegment Point="3.5977,20.4023" />
                <LineSegment Point="3.5977,19.5469" />
                <LineSegment Point="7.5469,15.5977" />
                <LineSegment Point="4.418,12.4688" />
                <QuadraticBezierSegment Point1="3.9609,12.0117" Point2="4.0898,11.373" />
                <QuadraticBezierSegment Point1="4.2188,10.7344" Point2="4.8164,10.5" />
                <LineSegment Point="9.1289,8.7773" />
                <QuadraticBezierSegment Point1="9.7617,8.5312" Point2="10.0664,7.9102" />
                <LineSegment Point="12.1523,3.7617" />
            </PathFigure>
        </PathGeometry>
        <DataTemplate x:Key="TagPillTemplate" x:DataType="vm:HistoryTagBarItem">
            <Grid Background="Transparent">
                <Border x:Name="TagPill"
                        CornerRadius="14"
                        Padding="10,2,3,2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" MaxWidth="204">
                        <TextBlock Text="{Binding Text}"
                                   ToolTipService.ToolTip="{Binding Name}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Padding="0,0,4,0"
                                   PointerPressed="OnPillPressed" />
                        <ToggleButton Grid.Column="1"
                                      Width="22"
                                      Height="22"
                                      MinWidth="0"
                                      MinHeight="0"
                                      Padding="0"
                                      CornerRadius="11"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Name}"
                                      ToolTipService.ToolTip="{x:Bind i18n:Strings.HistoryTagTogglePin}">
                            <ToggleButton.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorSecondary}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SubtleFillColorSecondary}" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorPrimary}" />
                            </ToggleButton.Resources>
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource PinnedGeometry}" Fill="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(IsPinned), Mode=OneWay}" />
                                    <Path Data="{StaticResource PinOutlineGeometry}" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Canvas>
                            </Viewbox>
                        </ToggleButton>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>
    <Grid>
        <StackPanel Spacing="12">
            <TextBlock Text="{x:Bind i18n:Strings.HistoryTagBarSettingsHint}" TextWrapping="Wrap" Opacity="0.65" />
            <ScrollViewer x:Name="_TagScroll"
                          MaxHeight="300"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border x:Name="_PinnedArea" Background="Transparent" MinHeight="72">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind i18n:Strings.HistoryTagBarPinned}" FontSize="12" Opacity="0.65" />
                            <ItemsControl x:Name="_PinnedTags"
                                          ItemsSource="{Binding PinnedTags}"
                                          ItemTemplate="{StaticResource TagPillTemplate}"
                                          MinHeight="28">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <toolkit:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Border x:Name="_UnpinnedArea" Background="Transparent" MinHeight="72">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind i18n:Strings.HistoryTagBarUnpinned}" FontSize="12" Opacity="0.65" />
                            <ItemsControl x:Name="_UnpinnedTags"
                                          ItemsSource="{Binding UnpinnedTags}"
                                          ItemTemplate="{StaticResource TagPillTemplate}"
                                          MinHeight="28">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <toolkit:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Text="{x:Bind i18n:Strings.HistoryTagBarEmpty}" Visibility="{x:Bind vc:ConvertMethod.BoolToVisibility(Model.IsEmpty), Mode=OneWay}" />
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>
        <Canvas x:Name="_DragLayer" IsHitTestVisible="False" />
    </Grid>
</ContentDialog>

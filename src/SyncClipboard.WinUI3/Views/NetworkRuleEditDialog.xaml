<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="SyncClipboard.WinUI3.Views.NetworkRuleEditDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:SyncClipboard.WinUI3.Views"
               xmlns:i18n="using:SyncClipboard.Core.I18n"
               xmlns:vm="using:SyncClipboard.Core.ViewModels"
               Title="{x:Bind i18n:Strings.EditRule}"
               PrimaryButtonText="{x:Bind i18n:Strings.Confirm}"
               CloseButtonText="{x:Bind i18n:Strings.Cancel}"
               DefaultButton="Primary">
    <ContentDialog.Resources>
        <Style TargetType="local:NetworkRuleEditDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
    </ContentDialog.Resources>
    <ScrollViewer MaxHeight="600" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="520" MaxWidth="680" Spacing="12">
            <TextBox Header="{x:Bind i18n:Strings.RuleName}" Text="{x:Bind Editor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ToggleSwitch OnContent="{x:Bind i18n:Strings.On}" OffContent="{x:Bind i18n:Strings.Off}" IsOn="{x:Bind Editor.Enabled, Mode=TwoWay}" />
            <ComboBox Header="{x:Bind i18n:Strings.TargetAccount}"
                      ItemsSource="{x:Bind _viewModel.Accounts}"
                      SelectedItem="{x:Bind Editor.TargetAccount, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName" />
            <ComboBox Header="{x:Bind i18n:Strings.NetworkInterface}"
                      ItemsSource="{x:Bind Interfaces}"
                      SelectedItem="{x:Bind Editor.SelectedInterface, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName" />
            <TextBox Header="{x:Bind i18n:Strings.IpRanges}"
                     MinHeight="86"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{x:Bind Editor.IpText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button HorizontalAlignment="Left" Content="{x:Bind i18n:Strings.UseCurrentIp}" Click="UseCurrentIpClick" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind i18n:Strings.PreferIpHint}" TextWrapping="Wrap" />
            <TextBox Header="{x:Bind i18n:Strings.WifiNames}"
                     MinHeight="86"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{x:Bind Editor.WifiText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button HorizontalAlignment="Left" Content="{x:Bind i18n:Strings.UseCurrentWifi}" Click="UseCurrentWifiClick" />
            <ComboBox Header="{x:Bind i18n:Strings.MatchMode}"
                      ItemsSource="{x:Bind vm:NetworkAccountSwitchViewModel.MatchModes}"
                      SelectedItem="{x:Bind Editor.SelectedMatchMode, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName" />
            <TextBlock x:Name="_ValidationMessage" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

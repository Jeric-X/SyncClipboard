<UserControl x:Class="SyncClipboard.WinUI3.Controls.HistoryRecordTagChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="using:SyncClipboard.Core.I18n">
    <Border Padding="8,2,5,2"
            CornerRadius="14"
            MaxWidth="220"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Name}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{Binding Name}" />
            <Button Grid.Column="1"
                    Style="{StaticResource DefaultButtonStyle}"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Width="16"
                    Height="16"
                    CornerRadius="8"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="2,0,0,0"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="RemoveTag_Click"
                    AutomationProperties.Name="{x:Bind i18n:Strings.HistoryTagRemove}"
                    AutomationProperties.HelpText="{Binding Name}"
                    ToolTipService.ToolTip="{x:Bind i18n:Strings.HistoryTagRemove}">
                <Viewbox Width="6" Height="6" Stretch="Uniform">
                    <PathIcon Width="8" Height="8" Data="M0,1 1,0 4,3 7,0 8,1 5,4 8,7 7,8 4,5 1,8 0,7 3,4 Z" />
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</UserControl>

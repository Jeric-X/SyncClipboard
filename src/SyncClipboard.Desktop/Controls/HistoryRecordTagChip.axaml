<UserControl x:Class="SyncClipboard.Desktop.Controls.HistoryRecordTagChip"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="using:SyncClipboard.Core.ViewModels.Sub"
             xmlns:i18n="using:SyncClipboard.Core.I18n"
             x:DataType="vms:HistoryPreviewTag">
    <Border Padding="8,2,5,2"
            CornerRadius="14"
            MaxWidth="220"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Name}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Name}" />
            <Button x:Name="RemoveButton"
                    Focusable="False"
                    Grid.Column="1"
                    Content="×"
                    Width="16"
                    Height="16"
                    CornerRadius="8"
                    FontSize="12"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="2,0,0,0"
                    Padding="0"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderThickness="0"
                    Click="Remove_Click"
                    AutomationProperties.Name="{x:Static i18n:Strings.HistoryTagRemove}"
                    AutomationProperties.HelpText="{Binding Name}"
                    ToolTip.Tip="{x:Static i18n:Strings.HistoryTagRemove}" />
        </Grid>
    </Border>
</UserControl>

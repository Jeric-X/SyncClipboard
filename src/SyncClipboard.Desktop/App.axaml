<Application x:Class="SyncClipboard.Desktop.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:local="using:SyncClipboard.Desktop.Views"
             xmlns:i18n="using:SyncClipboard.Core.I18n"
             xmlns:core="using:SyncClipboard.Core.Commons"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:m="using:SyncClipboard.Core.Models"
             Name="{x:Static core:Env.SoftName}"
             RequestedThemeVariant="Default">
    <!--  "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options.  -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ui:FAImageIcon x:Key="AppLogo" Source="/Assets/icon.png" />
                    <Color x:Key="WindowBackgroudColor">White</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ui:FAImageIcon x:Key="AppLogo" Source="/Assets/icon_white.png" />
                    <Color x:Key="WindowBackgroudColor">Black</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Linux already configures bundled MiSans as $Default. Resolving foreign font names
                 through fontconfig can repeatedly synthesize bold faces in Avalonia 12. -->
            <OnPlatform x:Key="DefaultFont" x:TypeArguments="FontFamily"
                        Linux="$Default" Default="Simsun,微软雅黑,Microsoft YaHei,苹方-简,PingFang SC,宋体-简,$Default" />
            <StaticResource x:Key="ProgramFont" ResourceKey="DefaultFont" />
            <GridLength x:Key="ToggleSwitchPreContentMargin">0</GridLength>
            <GridLength x:Key="ToggleSwitchPostContentMargin">0</GridLength>
            <Thickness x:Key="ToggleSwitchTopHeaderMargin">0,0,0,0</Thickness>
            <ui:FAImageIconSource x:Key="AppLogoSource" />
            <ui:FAImageIconSource x:Key="AppLogoSourceLight" Source="/Assets/icon.png" />
            <ui:FAImageIconSource x:Key="AppLogoSourceDark" Source="/Assets/icon_white.png" />
            <DataTemplate x:Key="LocaleStringTemplate" x:DataType="{x:Type m:LocaleString, x:TypeArguments=x:String}">
                <TextBlock Text="{Binding ShownString}" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="False" PreferUserAccentColor="True" />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource ProgramFont}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource ProgramFont}" />
        </Style>
        <!-- Caption buttons use the symbol font supplied by the decoration theme. -->
        <Style Selector="Button:not(.CaptionButton)">
            <Setter Property="FontFamily" Value="{DynamicResource ProgramFont}" />
        </Style>
        <Style Selector="ui|FAContentDialog /template/ Button">
            <Setter Property="FontFamily" Value="{DynamicResource ProgramFont}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox.spinRight /template/ Panel">
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style Selector="HyperlinkButton">
            <Setter Property="Padding" Value="0,0,0,-1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ToggleButton.FontIcon">
            <Setter Property="Height" Value="24" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
    <NativeMenu.Menu>
        <NativeMenu />
    </NativeMenu.Menu>
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/default.ico" MacOSProperties.IsTemplateIcon="True" ToolTipText="Avalonia Tray Icon ToolTip">
                <TrayIcon.Menu>
                    <NativeMenu />
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>

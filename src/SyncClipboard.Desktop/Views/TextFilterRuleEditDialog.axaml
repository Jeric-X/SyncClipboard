<ui:FAContentDialog x:Class="SyncClipboard.Desktop.Views.TextFilterRuleEditDialog"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:FluentAvalonia.UI.Controls"
                    xmlns:i18n="using:SyncClipboard.Core.I18n"
                    xmlns:m="using:SyncClipboard.Core.Models"
                    xmlns:vm="using:SyncClipboard.Core.ViewModels"
                    x:DataType="vm:EditableTextFilterRule"
                    PrimaryButtonText="{x:Static i18n:Strings.Confirm}"
                    CloseButtonText="{x:Static i18n:Strings.Cancel}"
                    DefaultButton="Primary"
                    IsPrimaryButtonEnabled="{Binding IsValid}">
    <StackPanel Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static i18n:Strings.MatchMode}" />
            <ComboBox ItemsSource="{x:Static vm:EditableTextFilterRule.MatchModes}" SelectedItem="{Binding MatchMode, Mode=TwoWay}" AutomationProperties.Name="{x:Static i18n:Strings.MatchMode}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type m:LocaleString, x:TypeArguments=x:Boolean}">
                        <TextBlock Text="{Binding ShownString}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static i18n:Strings.FileFilterPattern}" />
            <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Static i18n:Strings.TextFilterPattern}" AutomationProperties.Name="{x:Static i18n:Strings.FileFilterPattern}" />
            <TextBlock Text="{Binding ValidationError}"
                       IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox IsVisible="{Binding CanExcludeFromHistory}" IsChecked="{Binding ExcludeFromHistory, Mode=TwoWay}" Content="{x:Static i18n:Strings.ExcludeFromLocalHistory}" />
    </StackPanel>
</ui:FAContentDialog>

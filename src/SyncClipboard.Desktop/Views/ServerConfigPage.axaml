<UserControl x:Class="SyncClipboard.Desktop.Views.ServerConfigPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i18n="using:SyncClipboard.Core.I18n"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:SyncClipboard.Core.ViewModels"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:ServerConfigViewModel"
             mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Theme" Value="{StaticResource DateTimeFlyoutButtonStyle}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Styles>
    <ui:FASettingsExpander Header="{x:Static i18n:Strings.Server}" Description="{x:Static i18n:Strings.ServerDescription}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
            <ui:FAFontIconSource Glyph="&#xE753;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpander.Footer>
            <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding ServerEnable, Mode=TwoWay}" />
        </ui:FASettingsExpander.Footer>
        <ui:FASettingsExpander.Items>
            <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.Port}">
                <ui:FASettingsExpanderItem.Footer>
                    <NumericUpDown Minimum="1"
                                   Maximum="65535"
                                   Increment="1"
                                   FormatString="F0"
                                   Value="{Binding Port, Mode=TwoWay}" />
                </ui:FASettingsExpanderItem.Footer>
            </ui:FASettingsExpanderItem>
            <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.EnableCustomConfigurationFile}" Description="{x:Static i18n:Strings.CustomConfigFileDescription}">
                <ui:FASettingsExpanderItem.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{Binding OpenCustomConfigDescLinkCommand}">
                            <ui:FAFontIcon Glyph="&#xE9CE;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Button>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding EnableCustomConfigurationFile, Mode=TwoWay}" />
                    </StackPanel>
                </ui:FASettingsExpanderItem.Footer>
            </ui:FASettingsExpanderItem>
            <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.CustomConfigurationFilePath}" Description="{Binding CustomConfigurationFilePath, Mode=OneWay}" IsVisible="{Binding EnableCustomConfigurationFile, Mode=OneWay}">
                <ui:FASettingsExpanderItem.Footer>
                    <Button Click="SetCustomConfigurationFilePath">
                        <ui:FAFontIcon Glyph="&#xE838;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                    </Button>
                </ui:FASettingsExpanderItem.Footer>
            </ui:FASettingsExpanderItem>
            <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.EnableHttps}" IsVisible="{Binding ShowHttpsConfig}">
                <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding EnableHttps, Mode=TwoWay}" />
                </ui:FASettingsExpanderItem.Footer>
            </ui:FASettingsExpanderItem>
            <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.CertificatePemPath}" Description="{Binding CertificatePemPath, Mode=OneWay}" IsVisible="{Binding ShowHttpsCertConfig, Mode=OneWay}">
                <ui:FASettingsExpanderItem.Footer>
                    <Button Click="SetCertificatePemPath">
                        <ui:FAFontIcon Glyph="&#xE838;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                    </Button>
                </ui:FASettingsExpanderItem.Footer>
            </ui:FASettingsExpanderItem>
            <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.CertificatePemKeyPath}" Description="{Binding CertificatePemKeyPath, Mode=OneWay}" IsVisible="{Binding ShowHttpsCertConfig, Mode=OneWay}">
                <ui:FASettingsExpanderItem.Footer>
                    <Button Click="SetCertificatePemKeyPath">
                        <ui:FAFontIcon Glyph="&#xE838;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                    </Button>
                </ui:FASettingsExpanderItem.Footer>
            </ui:FASettingsExpanderItem>
        </ui:FASettingsExpander.Items>
    </ui:FASettingsExpander>
</UserControl>

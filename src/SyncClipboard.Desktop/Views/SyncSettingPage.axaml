<UserControl x:Class="SyncClipboard.Desktop.Views.SyncSettingPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:i18n="using:SyncClipboard.Core.I18n"
             xmlns:vm="using:SyncClipboard.Core.ViewModels"
             xmlns:local="using:SyncClipboard.Desktop.Views"
             xmlns:vc="using:SyncClipboard.Desktop.ValueConverters"
             x:DataType="vm:SyncSettingViewModel"
             d:DesignWidth="800"
             d:DesignHeight="450"
             mc:Ignorable="d">
    <Design.DataContext>
        <vm:SyncSettingViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <Style Selector="Button.IconButton">
            <Setter Property="Theme" Value="{StaticResource DateTimeFlyoutButtonStyle}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="ToggleButton.FontIcon">
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <vc:BoolToPasswordIconConverter x:Key="BoolToPasswordFontIcon" />
        <ui:FASymbolIconSource x:Key="GoIcon" Symbol="ChevronRight" />
    </UserControl.Resources>
    <StackPanel Spacing="10">
        <ui:FASettingsExpander Header="{x:Static i18n:Strings.SyncAccount}" IsExpanded="True">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource Glyph="&#xE13D;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <StackPanel>
                    <ComboBox MinWidth="200"
                              ItemsSource="{Binding SavedAccounts}"
                              SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                              PlaceholderText="{x:Static i18n:Strings.SelectAccount}"
                              IsVisible="{Binding IsLoggedIn}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{x:Static i18n:Strings.PleaseAddAccount}" IsVisible="{Binding !IsLoggedIn}" />
                </StackPanel>
            </ui:FASettingsExpander.Footer>
            <ui:FASettingsExpander.Items>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.AddAccount}"
                                         IsClickEnabled="True"
                                         Command="{Binding AddAccountCommand}"
                                         ActionIconSource="{StaticResource GoIcon}" />
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.EditAccountConfig}"
                                         IsClickEnabled="True"
                                         Command="{Binding EditAccountCommand}"
                                         IsVisible="{Binding HasSelectedAccount}"
                                         ActionIconSource="{StaticResource GoIcon}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Button MinWidth="60"
                                Margin="0,0,10,0"
                                Content="{x:Static i18n:Strings.DeleteAccount}"
                                Command="{Binding RemoveAccountCommand}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.AutoSwitchAccount}"
                                         Description="{Binding AccountAutoSwitchDescription}"
                                         IsClickEnabled="True"
                                         Command="{Binding OpenNetworkAccountSwitchCommand}"
                                         ActionIconSource="{StaticResource GoIcon}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding AccountAutoSwitchEnabled, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander.Items>
        </ui:FASettingsExpander>
        <ui:FASettingsExpander Header="{x:Static i18n:Strings.ClipboardSyncing}" IsExpanded="True">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource Glyph="&#xE117;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding SyncEnable, Mode=TwoWay}" />
            </ui:FASettingsExpander.Footer>
            <ui:FASettingsExpander.Items>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.QueryInterval}" IsVisible="{Binding ShowQueryInterval}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Minimum="0"
                                       Maximum="100000"
                                       Value="{Binding IntervalTime, Mode=TwoWay}"
                                       Increment="1"
                                       ButtonSpinnerLocation="Right" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.RetryTimes}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Minimum="0"
                                       Maximum="100000"
                                       Value="{Binding RetryTimes, Mode=TwoWay}"
                                       Increment="1" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.TimeoutPeriod}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Minimum="0"
                                       Maximum="100000"
                                       Value="{Binding TimeOut, Mode=TwoWay}"
                                       Increment="1"
                                       ButtonSpinnerLocation="Right" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.SendNotificationAfterManuallyUpload}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding NotifyOnManualUpload, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.SendNotificationAfterUpdateLocalClipboard}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding NotifyOnDownloaded, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.IgnoreExcludeForSyncSuggestion}" Description="{x:Static i18n:Strings.IgnoreExcludeForSyncSuggestionDescription}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding IgnoreExcludeForSyncSuggestion, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem ActionIconSource="{StaticResource GoIcon}"
                                         IsClickEnabled="True"
                                         Command="{Binding OpenSyncContentControlPageCommand}"
                                         Content="{x:Static i18n:Strings.SyncContentControl}" />
                <ui:FASettingsExpanderItem ActionIconSource="{StaticResource GoIcon}"
                                         IsClickEnabled="True"
                                         Command="{Binding SetClipboardOwnerFilterCommand}"
                                         Content="{x:Static i18n:Strings.ClipboardOwnerFilter}" />
                <ui:FASettingsExpanderItem ActionIconSource="{StaticResource GoIcon}"
                                         IsClickEnabled="True"
                                         Command="{Binding OpenClipboardAcquisitionRulesPageCommand}"
                                         Content="{x:Static i18n:Strings.ClipboardAcquisitionRules}" />
            </ui:FASettingsExpander.Items>
        </ui:FASettingsExpander>
        <ui:FASettingsExpander Header="{x:Static i18n:Strings.LocalClipboardSource}" IsExpanded="True" IsVisible="{Binding IsLinux}">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource Glyph="&#xE71C;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Items>
                <ui:FASettingsExpanderItem Content="Avalonia">
                    <ui:FASettingsExpanderItem.Footer>
                        <CheckBox IsChecked="{Binding AvaloniaEnabled, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="xclip">
                    <ui:FASettingsExpanderItem.Footer>
                        <CheckBox IsChecked="{Binding XClipEnabled, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="wl-clipboard">
                    <ui:FASettingsExpanderItem.Footer>
                        <CheckBox IsChecked="{Binding WlClipboardEnabled, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander.Items>
        </ui:FASettingsExpander>
    </StackPanel>
</UserControl>

<UserControl x:Class="SyncClipboard.Desktop.Views.FileSyncFilterSettingPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:i18n="using:SyncClipboard.Core.I18n"
             xmlns:vm="using:SyncClipboard.Core.ViewModels"
             x:DataType="vm:FileSyncFilterSettingViewModel"
             d:DesignWidth="800"
             d:DesignHeight="450"
             mc:Ignorable="d">
    <Design.DataContext>
        <vm:FileSyncFilterSettingViewModel />
    </Design.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:SettingsExpander Grid.Row="0" Header="{x:Static i18n:Strings.FilterMode}">
            <ui:SettingsExpander.IconSource>
                <ui:FontIconSource Glyph="&#xE71C;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </ui:SettingsExpander.IconSource>
            <ui:SettingsExpander.Footer>
                <ComboBox SelectedItem="{Binding FilterMode, Mode=TwoWay}" ItemsSource="{x:Static vm:FileSyncFilterSettingViewModel.Modes}" ItemTemplate="{StaticResource LocaleStringTemplate}" />
            </ui:SettingsExpander.Footer>
        </ui:SettingsExpander>
        <Grid Grid.Row="1" Margin="0,10,0,0" IsVisible="{Binding EnableList, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Left"
                    Click="AddItemClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" Text="&#xE710;" />
                    <TextBlock Text="{x:Static i18n:Strings.AddItem}" />
                </StackPanel>
            </Button>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="12,8"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{x:Static i18n:Strings.FileFilterPattern}" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Static i18n:Strings.MatchMode}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{x:Static i18n:Strings.Operation}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding FilterList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditableFileFilterRule">
                                <Border Padding="12,8"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,1,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Pattern}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding MatchMode.ShownString}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                            <Button Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="EditItemClick"
                                                    DataContext="{Binding}"
                                                    ToolTip.Tip="{x:Static i18n:Strings.EditRule}">
                                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Text="&#xE70F;" />
                                            </Button>
                                            <Button Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="DeleteItemClick"
                                                    DataContext="{Binding}"
                                                    ToolTip.Tip="{x:Static i18n:Strings.DeleteRule}">
                                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Text="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

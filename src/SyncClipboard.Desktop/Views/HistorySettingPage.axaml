<UserControl x:Class="SyncClipboard.Desktop.Views.HistorySettingPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:SyncClipboard.Desktop.Views"
             xmlns:vm="using:SyncClipboard.Core.ViewModels"
             xmlns:i18n="using:SyncClipboard.Core.I18n"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:HistorySettingViewModel"
             mc:Ignorable="d">
    <Design.DataContext>
        <vm:HistorySettingViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <local:HotkeyEditDialog x:Key="HotkeyEditor"
                                Hotkey="{Binding EditingShortcut, Mode=TwoWay}"
                                IsError="{Binding ShortcutHasError, Mode=OneWay}"
                                IsPrimaryButtonEnabled="{Binding CanSaveShortcut, Mode=OneWay}"
                                SaveCommand="{Binding SaveShortcutCommand, Mode=OneWay}"
                                ErrorMessage="{Binding ShortcutErrorMessage, Mode=OneWay}" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.HistoryShortcutAction">
            <Setter Property="Theme" Value="{StaticResource DateTimeFlyoutButtonStyle}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="Button.HistoryShortcutAction:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="10">
        <ui:FASettingsExpander Header="{x:Static i18n:Strings.ClipboardHistory}" Description="{x:Static i18n:Strings.HistoryPanelHotkeyDescription}" IsExpanded="True">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource Glyph="&#xE1D3;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding EnableHistory, Mode=TwoWay}" />
            </ui:FASettingsExpander.Footer>
            <ui:FASettingsExpander.Items>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.EnableSyncHistory}" Description="{x:Static i18n:Strings.EnableSyncHistoryDescription}" IsVisible="{Binding ServerSyncSupported}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding EnableSyncHistory, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.HistoryBackup}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Static i18n:Strings.Import}" Command="{Binding ImportHistoryCommand}" />
                            <Button Content="{x:Static i18n:Strings.Export}" Command="{Binding ExportHistoryCommand}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.ClearLocalHistory}" Description="{x:Static i18n:Strings.ClearLocalHistoryDescription}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Button Content="{x:Static i18n:Strings.ClearLocalHistory}" Command="{Binding ClearLocalHistoryCommand}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander.Items>
        </ui:FASettingsExpander>
        <ui:FASettingsExpander Header="{x:Static i18n:Strings.HistoryAutoDelete}" Description="{x:Static i18n:Strings.HistoryAutoDeleteDescription}" IsExpanded="True">
            <ui:FASettingsExpander.IconSource>
                <!--  Fluent UI System Icons (MIT): ic_fluent_broom_24_regular  -->
                <ui:FAPathIconSource Data="M22.4533 1.92279C22.7462 2.21569 22.7462 2.69056 22.4533 2.98345L15.5248 9.91202C17.2598 12.1668 17.0945 15.4134 15.0287 17.4791L14.1973 18.3106L11.4101 22.4913C11.2855 22.6783 11.0836 22.7995 10.86 22.8217C10.6364 22.8438 10.4146 22.7645 10.2557 22.6056L1.77046 14.1204C1.61157 13.9615 1.53229 13.7397 1.55444 13.5161C1.57658 13.2925 1.6978 13.0906 1.88476 12.966L6.06572 10.1787L6.89699 9.34742C8.96276 7.28165 12.2093 7.11629 14.4641 8.85136L21.3927 1.92279C21.6856 1.6299 22.1604 1.6299 22.4533 1.92279ZM7.6041 10.7616L13.6145 16.772L13.9681 16.4185C15.6278 14.7588 15.6278 12.0678 13.9681 10.4081C12.3083 8.74835 9.61738 8.74835 7.95765 10.4081L7.6041 10.7616ZM6.44786 11.7267L3.47801 13.7066L10.6695 20.8981L12.6494 17.9282L6.44786 11.7267Z" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Items>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.AutoDeleteMissingLocalFiles}" Description="{x:Static i18n:Strings.AutoDeleteMissingLocalFilesDescription}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding AutoDeleteMissingLocalFiles, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.MaxItemCount}" Description="{x:Static i18n:Strings.MaxItemCountDescription}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Minimum="0"
                                       Maximum="10000"
                                       Value="{Binding MaxItemCount, Mode=TwoWay}"
                                       Increment="1"
                                       ButtonSpinnerLocation="Right" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.HistoryRetentionMinutes}" Description="{x:Static i18n:Strings.HistoryRetentionDescription}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Minimum="0"
                                       Maximum="525600"
                                       Value="{Binding HistoryRetentionMinutes, Mode=TwoWay}"
                                       Increment="1"
                                       ButtonSpinnerLocation="Right" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.ProtectTaggedRecords}" Description="{x:Static i18n:Strings.ProtectTaggedRecordsDescription}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding ProtectTaggedRecords, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander.Items>
        </ui:FASettingsExpander>
        <ui:FASettingsExpander Header="{x:Static i18n:Strings.HistoryShortcutSettings}" IsExpanded="True" ItemsSource="{Binding ShortcutSettings}">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource Glyph="&#xE765;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <Button Content="{x:Static i18n:Strings.ResetAllHistoryKeyboardShortcuts}" Command="{Binding ResetHistoryShortcutsCommand}" />
            </ui:FASettingsExpander.Footer>
            <ui:FASettingsExpander.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryShortcutSetting">
                    <ui:FASettingsExpanderItem Content="{Binding Name}">
                        <ui:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal">
                                <local:HotkeyViewer Margin="5,0,10,0" Hotkey="{Binding Hotkey}" />
                                <Button Classes="HistoryShortcutAction" ToolTip.Tip="{x:Static i18n:Strings.Edit}" Click="EditShortcutClick">
                                    <ui:FAFontIcon Glyph="&#xE70F;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </Button>
                                <Button Classes="HistoryShortcutAction"
                                        ToolTip.Tip="{x:Static i18n:Strings.ResetToDefault}"
                                        Click="ResetShortcutClick"
                                        IsEnabled="{Binding IsModified}">
                                    <ui:FAFontIcon Glyph="&#xE7A7;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </Button>
                            </StackPanel>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </DataTemplate>
            </ui:FASettingsExpander.ItemTemplate>
        </ui:FASettingsExpander>
        <ui:FASettingsExpander Header="{x:Static i18n:Strings.HistoryWindowMouseOperations}" IsExpanded="True">
            <ui:FASettingsExpander.IconSource>
                <ui:FAPathIconSource Data="M10 1 C5.58 1 2 4.58 2 9 V15 C2 19.42 5.58 23 10 23 C14.42 23 18 19.42 18 15 V9 C18 4.58 14.42 1 10 1 Z M10 2.5 C13.59 2.5 16.5 5.41 16.5 9 V15 C16.5 18.59 13.59 21.5 10 21.5 C6.41 21.5 3.5 18.59 3.5 15 V9 C3.5 5.41 6.41 2.5 10 2.5 Z M10 5 C9.59 5 9.25 5.34 9.25 5.75 V9.25 C9.25 9.66 9.59 10 10 10 C10.41 10 10.75 9.66 10.75 9.25 V5.75 C10.75 5.34 10.41 5 10 5 Z" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Items>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.HistoryDoubleClick}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding MouseActions}"
                                  SelectedItem="{Binding DoubleClickAction, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding ShownString}"
                                  MinWidth="180" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.HistoryMiddleClick}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding MouseActions}"
                                  SelectedItem="{Binding MiddleClickAction, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding ShownString}"
                                  MinWidth="180" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander.Items>
        </ui:FASettingsExpander>
    </StackPanel>
</UserControl>

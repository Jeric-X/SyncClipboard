<UserControl x:Class="SyncClipboard.Desktop.Views.SystemSettingPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:i18n="using:SyncClipboard.Core.I18n"
             xmlns:vm="using:SyncClipboard.Core.ViewModels"
             xmlns:m="using:SyncClipboard.Core.Models"
             xmlns:hook="using:SharpHook.Data"
             xmlns:v="using:SyncClipboard.Desktop.Views"
             xmlns:Sys="using:System"
             xmlns:SysGeneric="using:System.Collections.Generic"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:SystemSettingViewModel"
             mc:Ignorable="d">
    <StackPanel Spacing="10">
        <ui:FASettingsExpander Header="{x:Static i18n:Strings.General}" IsExpanded="True">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource Glyph="&#xE9F5;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Items>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.RunAtSystemStartup}" IsVisible="{Binding ShowStartUpSetting}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding StartUpWithSystem, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.RunAsAdministrator}" IsVisible="{Binding ShowStartUpAsAdministratorSetting}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding StartUpAsAdministrator, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.HideOnStartup}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding HideWindowOnStartUp, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.UserConfigLocation}" IsVisible="{Binding ShowPortableLocationSetting}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox SelectedItem="{Binding UserConfigPosition, Mode=TwoWay}" ItemsSource="{x:Static vm:SystemSettingViewModel.UserConfigPositions}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="{x:Type m:LocaleString, x:TypeArguments=Sys:Boolean}">
                                    <TextBlock Text="{Binding ShownString}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.AppDataFolder}" Description="{Binding AppDataDirectory, Mode=OneTime}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding AppDataMoveProgress, Mode=OneWay}" IsVisible="{Binding IsMovingAppData, Mode=OneWay}" VerticalAlignment="Center" />
                            <Button Command="{Binding RestoreDefaultAppDataFolderCommand}" Content="{x:Static i18n:Strings.RestoreDefaultFolder}" IsVisible="{Binding IsUsingCustomIndependentAppDataDirectory, Mode=OneTime}" />
                            <Button Click="ChangeAppDataFolder"
                                    Content="{x:Static i18n:Strings.ChangeFolder}"
                                    IsEnabled="{Binding !IsMovingAppData, Mode=OneWay}"
                                    IsVisible="{Binding IsIndependentAppDataDirectory, Mode=OneWay}" />
                            <ComboBox SelectedItem="{Binding PortableAppDataFolderPosition, Mode=TwoWay}" ItemsSource="{x:Static vm:SystemSettingViewModel.PortableAppDataFolderPositions}" IsVisible="{Binding ShowPortableLocationSetting}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Type m:LocaleString, x:TypeArguments=Sys:Boolean}">
                                        <TextBlock Text="{Binding ShownString}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.Language}" Description="{Binding ChangingLangInfo, Mode=OneWay}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox SelectedItem="{Binding Language, Mode=TwoWay}" ItemsSource="{x:Static vm:SystemSettingViewModel.Languages}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:LanguageModel">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.Theme}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox SelectedItem="{Binding Theme, Mode=TwoWay}" ItemsSource="{x:Static vm:SystemSettingViewModel.Themes}" ItemTemplate="{StaticResource LocaleStringTemplate}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.Font}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox SelectedItem="{Binding Font, Mode=TwoWay}" ItemsSource="{Binding FontList}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.GlobalHotkeyEngine}"
                                           Description="{Binding LinuxInputModeDescription}"
                                           IsVisible="{Binding ShowGlobalHotkeyEngine}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox SelectedItem="{Binding LinuxInputMode, Mode=TwoWay}"
                                  ItemsSource="{x:Static vm:SystemSettingViewModel.LinuxInputModes}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="{x:Type m:LocaleString, x:TypeArguments=hook:LinuxMode}">
                                    <TextBlock Text="{Binding ShownString}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.Proxy}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Button Click="ShowProxySettingDialog" Content="{x:Static i18n:Strings.Config}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander.Items>
        </ui:FASettingsExpander>
        <ui:FASettingsExpander Header="{x:Static i18n:Strings.PermissionManagement}" IsExpanded="True" IsVisible="{Binding ShowInputPermissions}">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource Glyph="&#xE72E;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <Button Content="{x:Static i18n:Strings.Refresh}" Command="{Binding RefreshInputPermissionsCommand}" />
            </ui:FASettingsExpander.Footer>
            <ui:FASettingsExpander.Items>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.AccessibilityPermission}"
                                           Description="{x:Static i18n:Strings.AccessibilityPermissionDescription}"
                                           IsVisible="{Binding ShowAccessibilityPermission}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding AccessibilityPermissionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="{x:Static i18n:Strings.RequestPermission}"
                                    Command="{Binding RequestAccessibilityPermissionCommand}"
                                    IsVisible="{Binding CanRequestAccessibilityPermission}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="/dev/input/event*"
                                           Description="{x:Static i18n:Strings.KeyboardMonitoringPermissionDescription}"
                                           IsVisible="{Binding ShowInputDevicePermissions}">
                    <ui:FASettingsExpanderItem.Footer>
                        <TextBlock Text="{Binding KeyboardMonitoringPermissionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="/dev/uinput"
                                           Description="{x:Static i18n:Strings.InputSimulationPermissionDescription}"
                                           IsVisible="{Binding ShowInputDevicePermissions}">
                    <ui:FASettingsExpanderItem.Footer>
                        <TextBlock Text="{Binding InputSimulationPermissionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander.Items>
        </ui:FASettingsExpander>
        <ui:FASettingsExpander Header="{x:Static i18n:Strings.Diagnose}" IsExpanded="True">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource Glyph="&#xE9D9;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Items>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.TempFileRemainDays}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Minimum="0"
                                       Maximum="1000"
                                       Value="{Binding TempFileRemainDays, Mode=TwoWay}"
                                       Increment="1"
                                       ButtonSpinnerLocation="Right" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.LogRemainDays}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Minimum="0"
                                       Maximum="1000"
                                       Value="{Binding LogRemainDays, Mode=TwoWay}"
                                       Increment="1"
                                       ButtonSpinnerLocation="Right" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{x:Static i18n:Strings.DiagnoseMode}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{x:Static i18n:Strings.On}" OffContent="{x:Static i18n:Strings.Off}" IsChecked="{Binding DiagnoseMode, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander.Items>
        </ui:FASettingsExpander>
        <OnPlatform>
            <OnPlatform.Default>
                <ui:FASettingsExpander Header="{x:Static i18n:Strings.SystemOperations}" IsExpanded="True" ItemsSource="{x:Static v:SystemSettingPage.Operations}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xE90F;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                    </ui:FASettingsExpander.IconSource>
                    <ui:FASettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type SysGeneric:KeyValuePair, x:TypeArguments='x:String,Sys:Action'}">
                            <ui:FASettingsExpanderItem Content="{Binding Key, Mode=OneTime}">
                                <ui:FASettingsExpanderItem.Footer>
                                    <Button Content="{x:Static i18n:Strings.Run}" Command="{Binding $parent[v:SystemSettingPage].RunOperationCommand}" CommandParameter="{Binding Value, Mode=OneTime}" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </DataTemplate>
                    </ui:FASettingsExpander.ItemTemplate>
                </ui:FASettingsExpander>
            </OnPlatform.Default>
            <OnPlatform.macOS>
                <UserControl />
            </OnPlatform.macOS>
        </OnPlatform>
    </StackPanel>
</UserControl>
